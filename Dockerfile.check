# =============================================================================
# Dockerfile.check — KPHP binary build + PHAR build verification
#
# Verifies that lphenom/cache:
#   1. Compiles cleanly with KPHP (produces a working binary)
#   2. Can be packaged as a PHAR archive
#
# Usage:
#   docker build -f Dockerfile.check --target check-complete -t lphenom-cache-check .
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 0: Install PHP production dependencies using PHP 8.1
# (vkcom/kphp contains PHP 7.4 — not compatible with PHP 8.1 packages)
# Dependencies are pulled from GitHub via VCS repositories.
# -----------------------------------------------------------------------------
FROM php:8.1.31-cli AS install-deps

WORKDIR /build

# Accept GitHub token for private VCS repos (never persisted to image layer)
ARG COMPOSER_AUTH
ENV COMPOSER_AUTH=${COMPOSER_AUTH}

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends git unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2.9.5 /usr/bin/composer /usr/bin/composer

COPY composer.json ./

RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --prefer-dist \
        --optimize-autoloader

# -----------------------------------------------------------------------------
# Stage 1: KPHP binary build
# Uses the official vkcom/kphp image.
# KPHP parses PHP source and compiles to C++ → static binary.
# -----------------------------------------------------------------------------
FROM vkcom/kphp:latest AS kphp-build

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget -q --timeout=10 -O /etc/apt/trusted.gpg.d/vkpartner.asc \
         https://artifactory-external.vkpartner.ru/artifactory/api/gpg/key/public \
    && echo "deb [arch=amd64] https://artifactory-external.vkpartner.ru/artifactory/kphp focal main" \
         > /etc/apt/sources.list.d/vkpartner.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends php8.1-vkext \
    && echo "=== php8.1-vkext installed ===" \
    || echo "=== php8.1-vkext SKIPPED (no network — OK for compilation) ===" \
    ; rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY src/    ./src/
COPY build/  ./build/

# Copy vendor from install-deps stage (provides lphenom/* interfaces)
COPY --from=install-deps /build/vendor ./vendor/

RUN kphp \
        -d /build/kphp-out \
        -M cli \
        /build/build/kphp-entrypoint.php \
    && echo "=== KPHP compilation: OK ===" \
    && ls -lh /build/kphp-out/

RUN useradd -m kphp-runner \
    && su kphp-runner -c '/build/kphp-out/cli' \
    && echo "=== KPHP binary run: OK ==="

# -----------------------------------------------------------------------------
# Stage 2: PHAR build
# -----------------------------------------------------------------------------
FROM php:8.1.31-cli AS phar-build

WORKDIR /build

RUN echo "phar.readonly = Off" > /usr/local/etc/php/conf.d/phar.ini

COPY --from=composer:2.9.5 /usr/bin/composer /usr/bin/composer

COPY src/          ./src/
COPY build/        ./build/
COPY --from=install-deps /build/vendor ./vendor/

RUN php -d phar.readonly=0 /build/build/build-phar.php \
    && echo "=== PHAR build: OK ==="

RUN php /build/build/smoke-test-phar.php /build/lphenom-cache.phar \
    && echo "=== PHAR smoke-test: OK ==="

# -----------------------------------------------------------------------------
# Final stage — proves both stages completed
# -----------------------------------------------------------------------------
FROM scratch AS check-complete
COPY --from=kphp-build /build/kphp-out/cli       /kphp-cli-binary
COPY --from=phar-build /build/lphenom-cache.phar  /lphenom-cache.phar

