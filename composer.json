{
    "name": "lphenom/cache",
    "description": "LPhenom Cache — KPHP-compatible caching package with file, in-memory, DB and Redis drivers",
    "type": "library",
    "license": "MIT",
    "keywords": ["cache", "lphenom", "kphp", "php"],
    "authors": [
        {
            "name": "dmitrii-pov",
            "email": "popkovd.o@yandex.ru"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lphenom/storage"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lphenom/db"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lphenom/redis"
        }
    ],
    "require": {
        "php": ">=8.1",
        "lphenom/storage": "^0.1",
        "lphenom/db": "^0.2",
        "lphenom/redis": "^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "LPhenom\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LPhenom\\Cache\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/phpcs --standard=PSR12 src/ tests/",
        "lint-fix": "vendor/bin/phpcbf --standard=PSR12 src/ tests/",
        "analyse": "vendor/bin/phpstan analyse src/ --level=8"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}



